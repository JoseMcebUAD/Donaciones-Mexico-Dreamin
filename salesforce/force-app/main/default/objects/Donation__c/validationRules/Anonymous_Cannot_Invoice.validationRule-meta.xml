<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Anonymous_Cannot_Invoice</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Is_Anonymous__c, Needs_Invoice__c)</errorConditionFormula>
    <errorMessage>Anonymous donations cannot request an invoice.</errorMessage>
</ValidationRule>
